# Copy this file to ".env.backup" (same folder) and fill in an Admin login.
# This file is gitignored -- never committed. The backup/restore tool signs
# in with this account, so it must have the Admin role in Settings -> User
# Roles (the admin_set_triggers / admin_truncate_table functions restore
# needs both reject anyone who isn't an Admin).

BACKUP_EMAIL=
BACKUP_PASSWORD=
