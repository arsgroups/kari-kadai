VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional, LOCAL DEVELOPMENT ONLY — auto-signs you in with this account when running
# `npm run dev`, so you don't have to type your password every time while testing.
# Leave these out of Vercel's environment variables — the code path they enable only
# exists in dev builds anyway (Vite strips it from `vite build`), but there's no reason
# to put a real password in a hosting dashboard.
VITE_DEV_AUTO_LOGIN_EMAIL=
VITE_DEV_AUTO_LOGIN_PASSWORD=
